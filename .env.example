# Server port (Render sets PORT automatically)
PORT=8787

# Optional: enables the AI features (bullet rewriting, summary, tailoring, cover letters, resume import).
# Without it the app still works; AI buttons show as "not configured".
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5)
ANTHROPIC_MODEL=

# Optional: Adzuna adds broad US/UK/CA/AU/DE... job coverage. Free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: default Adzuna country code (us, gb, ca, au, de, fr, ...). Default: us
ADZUNA_COUNTRY=us

# Optional: USAJOBS federal jobs. Free key at https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Optional: comma-separated list of allowed CORS origins (only needed if the API is hosted apart from the UI)
CORS_ORIGINS=
